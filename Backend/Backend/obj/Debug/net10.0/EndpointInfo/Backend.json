    "schemas": {
      "AdminPostInput": {
        "required": [
          "title",
          "description"
        ],
        "type": "object",
        "properties": {
          "title": {
            "maxLength": 200,
            "type": "string"
          },
          "description": {
            "maxLength": 20000,
            "type": "string"
          },
          "email": {
            "maxLength": 254,
            "type": [
              "null",
              "string"
            ]
          },
          "phone": {
            "maxLength": 50,
            "type": [
              "null",
              "string"
            ]
          },
          "userId": {
            "maximum": 9223372036854776000,
            "minimum": 1,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "badges": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "AdminUserInput": {
        "required": [
          "username",
          "email"
        ],
        "type": "object",
        "properties": {
          "username": {
            "maxLength": 100,
            "minLength": 3,
            "pattern": "^[^\\d].{2,}$",
            "type": "string"
          },
          "email": {
            "maxLength": 254,
            "type": "string"
          },
          "password": {
            "type": [
              "null",
              "string"
            ]
          },
          "roleId": {
            "maximum": 9223372036854776000,
            "minimum": 1,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "isActive": {
            "type": "boolean"
          }
        }
      },
      "CreatePostDTO": {
        "type": "object",
        "properties": {
          "userId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
